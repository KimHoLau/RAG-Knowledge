# ===== 智谱开放平台（GLM-5.3 对话，必填）=====
# 获取地址：https://open.bigmodel.cn
ZHIPUAI_API_KEY=your-zhipuai-api-key

# 可选：LLM 覆盖配置（默认智谱官方端点 + glm-5.3，温度 0.3）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.3
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_RETRIES=2

# ===== PostgreSQL（与 docker/docker-compose.yml 保持一致）=====
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=ragknowledge
PG_USERNAME=rag
PG_PASSWORD=rag123456
# 连接池（默认 20/5，并发上传较多时上调）
# PG_POOL_MAX=20
# PG_POOL_MIN_IDLE=5

# ===== 向量服务（OpenAI 兼容 /embeddings）=====
# 本地 Ollama：先执行 `ollama pull qwen3-embedding:4b-q4_K_M`（4GB 显存可完整装入；模型原生 2560 维，
# 后端请求带 dimensions=1024 截断，与 pgvector 匹配。换模型须保证输出 1024 维），base-url 用 http://localhost:11434/v1
# SiliconFlow：base-url 用 https://api.siliconflow.cn/v1，API Key 填平台密钥
# vLLM/Xinference 等自建服务同理，均以 /v1 结尾
# 离线调试链路可用：node scripts/mock-embedding-server.mjs，base-url 用 http://localhost:9999/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=no-key
EMBEDDING_MODEL=qwen3-embedding:4b-q4_K_M
# EMBEDDING_TIMEOUT_SECONDS=120
# EMBEDDING_MAX_RETRIES=2

# ===== 重排序服务（Jina/Cohere 风格 /rerank 协议，检索精排）=====
# 注意：Ollama 没有原生 rerank 端点，Qwen3-Reranker 需用以下任一方式承载：
#   llama.cpp：llama-server -m <gguf> --embedding --pooling rank --rerank --port 8900 -ub 1024
#              （llama-server 默认端口 8080 与后端冲突，故默认配置用 8900；
#               -ub 1024 必加：默认物理批 512 装不下"指令模板+问题+整条切片"，精排会全部报 500）
#              GGUF 必须选带 rank 头的转换版（实测可用：hf-mirror 的 Voodisss/Qwen3-Reranker-4B-GGUF-llama_cpp、
#              ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF；mradermacher 等普通转换无 rerank 元数据，打分恒近 0 无效）
#              4GB 显存参考（GTX 1650 Ti 实测 ~150 tok/s）：-c 2048 -ngl 99 -ub 1024 可整机入显存；
#              后端默认已按此调优（切片 400 token、候选 10、超时 90s，10 条候选 ≈ 30s），
#              强 GPU / SiliconFlow 云端可把 chunk-size 调回 800、RAG_CANDIDATE_TOP_K 调回 20
#   SiliconFlow：base-url 用 https://api.siliconflow.cn/v1，API Key 填平台密钥，模型名如 Qwen/Qwen3-Reranker-4B
#   vLLM/Xinference 等自建服务同理，base-url 均以 /v1 结尾（客户端拼接 /rerank）
# 未启用或服务不可用时自动退回向量排序，不影响问答可用性
RERANK_ENABLED=true
RERANK_BASE_URL=http://localhost:8900/v1
RERANK_API_KEY=no-key
RERANK_MODEL=Qwen3-Reranker-4B:Q4_K_M
# RERANK_TIMEOUT_SECONDS=30

# ===== RAG 参数（可选）=====
# RAG_TOP_K=5
# RAG_CANDIDATE_TOP_K=20（送入重排序的向量召回候选数，服务端截到 50 上限）
# RAG_SIMILARITY_THRESHOLD=0.45

# 入库线程池（Tika 解析 + 批量向量化，默认 2/4/100）
# INGEST_CORE_POOL_SIZE=2
# INGEST_MAX_POOL_SIZE=4
# INGEST_QUEUE_CAPACITY=100

# 应用日志级别（默认 DEBUG；生产建议 INFO）
# LOG_LEVEL=DEBUG

# ===== CORS（可选）=====
# 允许的前端来源（逗号分隔）；前端换端口或部署到其他域名时修改
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
